# ── Build (Railway/Railpack) ──
# Railway ya no usa Nixpacks por defecto -- el builder actual es Railpack.
RAILPACK_PYTHON_VERSION=3.13

# ── BingX ─────────────────────────────
BINGX_API_KEY=
BINGX_SECRET_KEY=

# HEDGE o ONEWAY -- consulta tu cuenta: app BingX > Futuros > Preferencias >
# Modo de posicion. El bot original asumia siempre ONEWAY.
POSITION_MODE=ONEWAY

# ── Symbol & timeframe ────────────────
# Se ignora si SCAN_ALL_SYMBOLS=true (queda solo como fallback/log).
SYMBOL=BTC-USDT
INTERVAL=15m

# ── Escaneo de todo el exchange ───────
# false = solo SYMBOL (comportamiento original). true = todos los USDT-M activos.
SCAN_ALL_SYMBOLS=false
SYMBOL_BLACKLIST=
MIN_24H_VOLUME_USDT=0
MAX_WORKERS=15
SYMBOL_REFRESH_CYCLES=20

# Frenos obligatorios al escanear todo el exchange -- sin esto, varias
# señales en el mismo ciclo abrirían una posición cada una sin límite.
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=8

# ── Risk ──────────────────────────────
LEVERAGE=10
USDT_PER_TRADE=50
ATR_SL_MULT=1.5
ATR_TP_MULT=2.5

# ── Precision (adjust per symbol) ─────
PRICE_PRECISION=2
QTY_PRECISION=3

# ── Mode ──────────────────────────────
# true  = log only, no real orders
# false = live trading
DRY_RUN=true

# ── Data ──────────────────────────────
MAX_BARS=300

# ── Strategy params ───────────────────
SWING_LEN=10
ATR_FILTER=true
ATR_MULT=0.5
COOLDOWN=5
EQ_TOL=0.1
CONF_TOL=0.3
STRICT_ENGULF=true
SWEEP_BOOST=true

# ── Telegram ──────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Railway (auto-set) ────────────────
PORT=8080
