# ── Credenciales BingX ────────────────────────────────────────────────
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_BASE_URL=https://open-api.bingx.com
BINGX_RECV_WINDOW_MS=5000
DEMO_MODE=False

# ── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LIVE_TRADING=True

# ── Universo de símbolos ─────────────────────────────────────────────
SYMBOLS=ALL
# El script original no fija timeframe. 15m es punto de partida
# razonable para estructura/reversión; cámbialo si prefieres otro.
TIMEFRAME=15m

POLL_INTERVAL_SECONDS=60
SYMBOL_BATCH_SIZE=5
SYMBOL_BATCH_DELAY_SECONDS=1.0

# ── Parámetros de detección (idénticos a los inputs del script Pine) ──
SWING_LENGTH=5
SWEEP_ATR_LENGTH=14
MIN_PENETRATION_ATR=0.0
STRUCTURE_LENGTH=3
MAX_CONFIRMATION_BARS=12
MIN_DISPLACEMENT_ATR=0.2

# ── Riesgo ────────────────────────────────────────────────────────────
QTY_PCT=10.0
LEVERAGE=10
# Diseño propio -- el Pine original es solo visual, no trae SL/TP.
# SL = nivel barrido +/- este multiplo de ATR de colchón.
SWEEP_SL_ATR_BUFFER=0.3
# TP = entrada +/- (riesgo * este ratio)
SWEEP_RR_RATIO=2.0

# ── Salvaguardas propias del bot ───────────────────────────────────────
MAX_CONCURRENT_POSITIONS=5
SKIP_IF_SYMBOL_HAS_POSITION=True
MIN_BALANCE_USDT=0

LOG_LEVEL=INFO
