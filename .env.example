# ── BingX ──
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_BASE_URL=https://open-api.bingx.com

# ── Modo -- SIGNAL (solo notifica) o LIVE. Empieza en SIGNAL SIEMPRE --
# esta estrategia nunca se ha backtesteado, y aqui corre sobre TODO el
# universo de simbolos, no solo uno -- mas exposicion potencial, mas
# razon para la cautela, no menos. ──
MODE=SIGNAL

# ── Universo ──
QUOTE_ASSET=USDT
SYMBOL_BLACKLIST=
SYMBOL_WHITELIST=
MIN_24H_VOLUME_USDT=0
SYMBOL_REFRESH_MIN=60

# Excluye NCS/NCCO/NCFX (acciones/materias primas/forex tokenizados con
# horario de mercado real) -- bingx-ict-scanner nunca tuvo este filtro,
# aqui si hace falta al escanear TODO el universo.
EXCLUDE_TOKENIZED_ASSETS=true

# ── Parametros del patron (identicos al bot de un solo simbolo) ──
PIVOT_LEN=3
ZONE_TOLERANCE_PCT=0.5
PEAK3_BELOW_ZONE_PCT_MIN=0.15
REQUIRE_WEAK_PUSH=true
WEAK_PUSH_MAX_RATIO=0.85

# ── Riesgo ──
RISK_PCT=1.0
SL_BUFFER_ATR_MULT=0.3
RR_RATIO=2.0
MIN_RR=1.5
ATR_LEN=14

# ── Limites de exposicion -- GLOBALES, no por simbolo (ver config.py) ──
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=10

# ── Circuit breaker -- nunca toca posiciones ya abiertas, solo frena
# señales NUEVAS. Ver la nota completa en state.py sobre por que usa
# conteo de perdidas y no % de drawdown (este bot no trackea P&L en $). ──
USE_CIRCUIT_BREAKER=true
LOSS_STREAK_THRESHOLD=3
MAX_DAILY_LOSSES=3

# ── Tier tracking -- para comparar si el patron rinde distinto en
# majors vs altcoins, con datos propios desde el primer trade. ──
MAJOR_SYMBOLS=BTC-USDT,ETH-USDT,XRP-USDT,BNB-USDT,SOL-USDT

# ── Sesgo HTF -- filtro de tendencia superior antes de aceptar el SHORT.
# Solo se consulta para simbolos donde el patron YA confirmo la ruptura,
# no en cada simbolo del universo cada ciclo. ──
USE_HTF_BIAS=true
HTF_TIMEFRAME=4h
HTF_EMA_LEN=50

# ── Escaneo ──
SCAN_INTERVAL_SEC=300
CANDLE_LIMIT=150
MAX_CONCURRENT_FETCHES=12

# ── Persistencia -- requiere un volumen de Railway montado en /data ──
STATE_FILE=/data/state.json

# ── Telegram (opcional pero muy recomendado con multiples simbolos) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
