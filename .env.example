# ── Modo ──────────────────────────────────────────────────────────
# SIGNAL = solo avisa por Telegram (recomendado hasta tener 100+ operaciones medidas)
# LIVE   = envía órdenes reales, y ADEMÁS exige LIVE_CONFIRMED=true
MODE=SIGNAL
LIVE_CONFIRMED=false

# ── BingX (solo hacen falta en LIVE) ──────────────────────────────
BINGX_API_KEY=
BINGX_API_SECRET=

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Filtro de amplitud: el hallazgo principal del proyecto ────────
MIN_ATR_PCT=4.0
COST_ROUNDTRIP_PCT=0.14
MIN_COST_COVER=30

# ── Estrategia (misma que reversion_5m.pine) ──────────────────────
TIMEFRAME=5m
MA_LEN=20
ATR_LEN=14
STRETCH_ATR=2.5
MAX_BARS_STRETCH=6
SL_ATR=1.0
TP_MODE=MEAN
RR_FIXED=1.5
MIN_RR=1.0

# ── Riesgo ────────────────────────────────────────────────────────
RISK_PCT=0.5
MAX_CONCURRENT=2
LEVERAGE=3
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=120

# ── Escaneo ───────────────────────────────────────────────────────
SCAN_INTERVAL_SEC=60
MAX_SYMBOLS=200

# ── Escáner del universo completo (sustituye al radar manual) ─────
# Recorre TODOS los perpetuos y manda un ranking por Telegram.
SCAN_ALL=true
RANK_INTERVAL_MIN=15
RANK_TOP_N=12
# Si BingX empieza a devolver 429, BAJA esto antes que subir el intervalo.
SCAN_CONCURRENCY=8
RANGE_LEN=20
ER_SHORT=30
ER_LONG=180
ER_TREND=0.40
EXCLUDE_PREFIXES=NC
SYMBOL_WHITELIST=

# ── Avisos de Telegram ────────────────────────────────────────────
DAILY_SUMMARY=true
DAILY_SUMMARY_HOUR_UTC=7
HEARTBEAT_HOURS=12

# ── Estado (monta un volumen de Railway en /data) ─────────────────
STATE_PATH=/data/state.json
LOG_LEVEL=INFO
