# ── BingX ─────────────────────────────
BINGX_API_KEY=
BINGX_SECRET_KEY=

# ── Symbol & timeframe ────────────────
SYMBOL=BTC-USDT
INTERVAL=15m

# ── Risk ──────────────────────────────
LEVERAGE=10
USDT_PER_TRADE=50
ATR_SL_MULT=1.5
ATR_TP_MULT=2.5

# ── Precision (adjust per symbol) ─────
PRICE_PRECISION=2
QTY_PRECISION=3

# ── Mode ──────────────────────────────
# true  = log only, no real orders
# false = live trading
DRY_RUN=true

# ── Data ──────────────────────────────
MAX_BARS=300

# ── Strategy params ───────────────────
SWING_LEN=10
ATR_FILTER=true
ATR_MULT=0.5
COOLDOWN=5
EQ_TOL=0.1
CONF_TOL=0.3
STRICT_ENGULF=true
SWEEP_BOOST=true

# ── Telegram ──────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Railway (auto-set) ────────────────
PORT=8080
